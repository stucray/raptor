# raptor ops configuration (#322).
#
# Copy to ~/.raptor/ops.env (or to your RAPTOR_STATE_DIR/ops.env) and edit.
# Every ops script and bin/deploy-agents reads it through
# scripts/raptor-ops-env.sh; bin/deploy-agents copies it beside the deployed
# scripts so launchd jobs read exactly what the deploy read.
#
# KEY=value, one per line. `~` and $HOME are expanded; nothing else is. The
# environment overrides anything here. Every line below shows the DEFAULT, so a
# file containing only the lines you change is complete.

# --- where things live -------------------------------------------------------
# The state directory: deployed scripts, logs, de-dupe state, and this file.
# Outside every repo on purpose — a branch checkout must not be able to rewrite
# or delete a watchdog mid-run.
RAPTOR_STATE_DIR=~/.raptor
# Where the nightly pg_dump of `raw` goes, and the file stem it uses. A machine
# taking over an existing backups directory sets the stem to match its files.
RAPTOR_BACKUP_DIR=~/.raptor/backups
RAPTOR_BACKUP_PREFIX=raptor-raw

# --- launchd ------------------------------------------------------------------
# Labels are <prefix>.<agent>, e.g. local.raptor.heartbeat. Use your own
# reverse-DNS prefix if you prefer.
RAPTOR_LABEL_PREFIX=local.raptor
# Which agents this machine runs, of: heartbeat keep-awake backup restore-drill
# close-out. A SHADOW heartbeat beside another deployment lists only `heartbeat`
# and also sets RESTART_ENABLED=false (below) and no RAPTOR_SECRETS.
RAPTOR_AGENTS=heartbeat keep-awake backup restore-drill close-out
# When the scheduled agents fire, in UTC. StartCalendarInterval is local time,
# so bin/deploy-agents converts these when it renders the plists — re-deploy
# after a clock or timezone change.
RAPTOR_CLOSE_OUT_UTC=23:30
RAPTOR_BACKUP_UTC=05:47
RAPTOR_RESTORE_DRILL_UTC=06:11

# --- the stack ----------------------------------------------------------------
# raptor's backend, and the containers compose.yaml starts.
RAPTOR_BACKEND_URL=http://127.0.0.1:8085
RAPTOR_POSTGRES_CONTAINER=raptor-postgres-1
RAPTOR_BACKEND_CONTAINER=raptor-backend-1
RAPTOR_FRONTEND_CONTAINER=raptor-frontend-1
RAPTOR_DB_NAME=paddock
RAPTOR_DB_USER=paddock

# --- custody -----------------------------------------------------------------
# The host directory compose mounts as the custody root. bin/up exports every
# key in this file, so compose sees it; a bare `docker compose up` does not.
# RAPTOR_DATA_ROOT=~/raptor/data

# --- alerting -----------------------------------------------------------------
# A sops-encrypted YAML file holding `ntfy-enabled: true` and `ntfy-topic: …`,
# decrypted at run time and never written to disk. Empty (the default) means no
# alert is sent: each script logs what it would have said instead. `bin/up`
# reads the Betfair credentials from the same file (`betfair-app-key-live`,
# `betfair-username`, `betfair-password`, `betfair-cert-pem`, `betfair-key-pem`);
# without it the stack starts and the recorder captures nothing.
RAPTOR_SECRETS=
# ntfy server; the topic comes from the secrets file, never from here.
# NTFY_BASE_URL=https://ntfy.sh

# --- the heartbeat's hands -----------------------------------------------------
# The heartbeat restarts the backend container after RESTART_AFTER consecutive
# checks that find it wedged. false makes it observe-only — what a shadow wants.
# RESTART_ENABLED=true
