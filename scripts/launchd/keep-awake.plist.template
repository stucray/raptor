<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <!-- Runs the copy in the state directory (RAPTOR_STATE_DIR), not the one in the repo. This plist used
         to be GENERATED by `keep-awake --install`, which wrote whatever
         absolute path the script happened to be sitting at — so the loaded job
         pointed into the working tree, and a branch checkout could rewrite the
         agent holding the machine awake, mid-match (#192).

         The generator's stated reason was that a committed plist would carry a
         placeholder somebody eventually loads without substituting, and
         launchd fails silently on that. True when it was written, and no
         longer: the deploy target is a fixed path now, so this file names it
         outright the way its three siblings do, and nothing has to be
         substituted at all. See bin/deploy-agents. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@STATE_DIR@/keep-awake</string>
    </array>

    <!-- KeepAlive, not StartInterval: this one is a resident poll loop, not a
         periodic check, because the assertion has to be HELD continuously. A
         crash must bring it straight back — the failure it guards against
         (#107) is invisible while it lasts. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- launchd gives a job /usr/bin:/bin:/usr/sbin:/sbin and not the
         interactive shell's PATH. Both binaries this needs are inside it, and
         it is stated anyway: an agent's first fire is the first time the
         launchd environment is ever exercised. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>@STATE_DIR@/keep-awake.log</string>
    <key>StandardErrorPath</key>
    <string>@STATE_DIR@/keep-awake.log</string>
</dict>
</plist>
