<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <!-- Runs the copy in the state directory (RAPTOR_STATE_DIR), not the one in the repo: a branch checkout
         must not be able to delete or rewrite the watchdog mid-run. See the
         DEPLOY block in scripts/raptor-heartbeat.sh; keep the two in sync. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@STATE_DIR@/raptor-heartbeat.sh</string>
    </array>

    <!-- Immediately on load, then every 5 minutes. launchd coalesces fires
         missed across sleep/wake into a single run, which is what makes this a
         LaunchAgent rather than a crontab entry — the machine suspending is one
         of the conditions being watched for (#107). -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- launchd hands a job a near-empty environment. HOME is needed for the
         age key and the state file; the script sets its own PATH regardless. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>@STATE_DIR@/heartbeat.log</string>
    <key>StandardErrorPath</key>
    <string>@STATE_DIR@/heartbeat.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
